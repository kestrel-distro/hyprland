# Maintainer: Kestrel <https://github.com/kestrel-distro>
#
# Lean Hyprland build for Kestrel: Clang, ThinLTO, x86-64-v3, no hyprpm.
#
# Built from this fork at the pinned release branch kestrel/0.56.2 (tag v0.56.2
# plus Kestrel source changes), not upstream `main`: main needs the matching
# hypr*-git libraries, which Kestrel does not ship. Pinning the release keeps ABI
# compatibility with Arch's stable hyprutils/hyprlang/aquamarine. To update,
# branch kestrel/<ver> from the new upstream tag, adapt Kestrel's changes onto
# it, then bump pkgver and _kestrel_branch below.
#
# The package is named hyprland-kestrel and conflicts/replaces/provides the Arch
# package, so Arch's stock hyprland can never install or overwrite it. Updates
# come only from the Kestrel [kestrel] repository. The installed binary and
# files are the same as upstream's.
#
# Build options:
#   _kestrel_march   x86-64-v3 (default); x86-64-v4 or native to retarget
#   _kestrel_lto     thin (default) | none
#   _kestrel_pgo     no (default) | generate | use   (see packaging/PGO.md)

pkgname=hyprland-kestrel
pkgver=0.57.0
pkgrel=1
pkgdesc='a highly customizable dynamic tiling Wayland compositor'
arch=(x86_64)
url="https://github.com/hyprwm/Hyprland"
license=(BSD-3-Clause)
depends=(cairo # libcairo.so
         aquamarine libaquamarine.so
         libgcc # libgcc_s.so
         'libstdc++' # libstdc++.so
         glibc # libc.so libm.so
         glib2 libgio-2.0.so libgobject-2.0.so
         glslang # libglslang-default-resource-limits.so libglslang.so
         hyprcursor libhyprcursor.so
         hyprgraphics libhyprgraphics.so
         hyprland-guiutils
         hyprlang libhyprlang.so
         hyprutils libhyprutils.so
         hyprwire libhyprwire.so
         lcms2 liblcms2.so
         libcanberra
         libdisplay-info
         libdrm # libdrm.so
         libglvnd libEGL.so libGLESv2.so
         libinput # libinput.so
         libx11
         libxcb # libxcb-dri3.so libxcb-present.so libxcb-render.so libxcb-res.so libxcb-shm.so libxcb.so libxcb-xfixes.so libxcb-xinput.so
         libxcomposite # libxcb-composite.so
         libxcursor # libXcursor.so
         libxfixes
         libxkbcommon libxkbcommon.so
         libxrender
         lua # liblua.so
         mesa # libgbm.so
         polkit
         sdbus-cpp
         seatd
         systemd-libs
         muparser # libmuparser.so
         opengl-driver
         pango libpango-1.0.so libpangocairo-1.0.so
         pixman libpixman-1.so
         re2 libre2.so
         tomlplusplus libtomlplusplus.so
         util-linux-libs libuuid.so
         wayland libwayland-server.so
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors # libxcb-errors.so
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil # libxcb-render-util.so
         xcb-util-wm # libxcb-ewmh.so libxcb-icccm.so
         xorg-xwayland)
makedepends=(cmake
             clang
             git
             glaze
             hyprland-protocols
             hyprwayland-scanner
             lld
             llvm
             meson
             mold
             ninja
             xorgproto)
optdepends=('hyprshutdown: clean logout and shutdown helper'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=(hyprland wayland-compositor)
conflicts=(hyprland)
replaces=(hyprland)
options=(!debug)

: "${_kestrel_march:=x86-64-v3}"
: "${_kestrel_lto:=thin}"
: "${_kestrel_pgo:=no}"
: "${_kestrel_pgo_dir:=/tmp/hyprland.profdata}"

_kestrel_branch="main"
_archive="hyprland"
source=("$_archive::git+https://github.com/kestrel-distro/hyprland.git#branch=$_kestrel_branch")
sha256sums=('SKIP')

prepare() {
	cd "$_archive"
	# The release tarball bundles these; a git checkout does not.
	git submodule update --init --recursive
	# Drop the global -fno-lto so ThinLTO can be enabled. Plugins built through
	# hyprpm are the reason upstream disables it; Kestrel builds with NO_HYPRPM.
	sed -i '/add_compile_options(-fno-lto)/d' CMakeLists.txt
	# Arch's glaze is newer than the range the project pins for hyprpm.
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt 2>/dev/null || true
}

build() {
	cd "$_archive"
	# Clang's -mtune rejects x86-64-v3; -march alone targets the baseline.
	local _cflags="$CFLAGS -march=${_kestrel_march}"
	local _ldflags="$LDFLAGS"
	if [[ "$_kestrel_lto" == "thin" ]]; then
		_cflags+=" -flto=thin"
		_ldflags+=" -flto=thin -fuse-ld=mold"
	fi
	case "$_kestrel_pgo" in
		no) ;;
		generate)
			_cflags+=" -fprofile-generate=$_kestrel_pgo_dir"
			_ldflags+=" -fprofile-generate=$_kestrel_pgo_dir"
			;;
		use)
			_cflags+=" -fprofile-use=$_kestrel_pgo_dir -fprofile-correction"
			_ldflags+=" -fprofile-use=$_kestrel_pgo_dir"
			;;
		*) error "invalid _kestrel_pgo: $_kestrel_pgo (no|generate|use)" ;;
	esac
	local _cmake=(
		-B build -S . -G Ninja -W no-dev
		-DCMAKE_BUILD_TYPE=Release
		-DCMAKE_INSTALL_PREFIX=/usr
		-DNO_HYPRPM=1
		-DCMAKE_C_COMPILER=clang
		-DCMAKE_CXX_COMPILER=clang++
		-DCMAKE_C_FLAGS="$_cflags"
		-DCMAKE_CXX_FLAGS="$_cflags"
		-DCMAKE_EXE_LINKER_FLAGS="$_ldflags"
		-DCMAKE_SHARED_LINKER_FLAGS="$_ldflags"
	)
	if [[ "$_kestrel_lto" == "thin" ]]; then
		_cmake+=(-DCMAKE_AR="$(command -v llvm-ar)" -DCMAKE_RANLIB="$(command -v llvm-ranlib)" -DCMAKE_NM="$(command -v llvm-nm)")
	fi
	cmake "${_cmake[@]}"
	cmake --build build
}

package() {
	cd "$_archive"
	DESTDIR="$pkgdir" cmake --install build
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find "$pkgdir" -name '*hyprpm*' -delete
	install -Dm0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
